# Python virtual environments
.venv/
venv/
env/

# Python generated files
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging
*.egg-info/
build/
dist/
.eggs/

# Testing and quality-tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Generated project data
data/raw/*
data/processed/*
artifacts/*
sandbox/*

# Preserve directory placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!artifacts/.gitkeep
!sandbox/.gitkeep

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE settings
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini