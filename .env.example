# EvoForge AI application settings
EVOFORGE_ENVIRONMENT=development
EVOFORGE_DEBUG=false
EVOFORGE_LOG_LEVEL=INFO

# Local database
EVOFORGE_DATABASE_URL=sqlite+aiosqlite:///./data/processed/evoforge.db

# Frontend access
EVOFORGE_ALLOWED_ORIGINS=["http://localhost:5173"]

# Safe execution limits
EVOFORGE_SANDBOX_TIMEOUT_SECONDS=300
EVOFORGE_MAX_PATCH_CANDIDATES=3

# AI provider configuration
EVOFORGE_LLM_PROVIDER=none

# Add real keys only inside your private .env file
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=